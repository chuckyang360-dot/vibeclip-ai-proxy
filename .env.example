PROXY_AUTH_TOKEN=replace-with-your-internal-token
OPENAI_API_KEY=replace-with-your-api-key
# xAI 示例：https://api.x.ai/v1 ；官方 OpenAI：https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 文本 chat/completions（/text/completions 等）：不设可能在下游报「未配置模型」
XAI_TEXT_MODEL=
XAI_MODEL=grok-4.20

# 图片 /images/generations 专用（绝不回退到上面的 XAI_MODEL，避免把 grok-4.20 发到图片接口）
# 优先级：请求 body.model → XAI_IMAGE_MODEL → SHORT_DRAMA_XAI_IMAGE_MODEL → IMAGE_MODEL → grok-imagine-image
XAI_IMAGE_MODEL=grok-imagine-image

# S1 视觉 /s1/vision（可选；不设则按顺序尝试 XAI_MODEL、OPENAI_MODEL）
# S1_VISION_MODEL=

# OPENAI_MODEL=gpt-4o
REQUEST_TIMEOUT_SECONDS=120

# S5 视频代理 /api/xai/videos/generations（阿里云 VIDEO_PROVIDER=railway_xai_proxy）
# xAI 成功后由 Railway 下载 mp4 并写入 R2；阿里云只消费返回的 R2 video_url
# XAI_API_KEY=your-xai-key
# XAI_VIDEO_MODEL=grok-imagine-video
# XAI_API_BASE=https://api.x.ai/v1
# XAI_VIDEO_TIMEOUT_SECONDS=600
# XAI_VIDEO_POLL_INTERVAL_SECONDS=3
# XAI_VIDEO_POLL_TIMEOUT_SECONDS=600
# RAILWAY_XAI_VIDEO_PROXY_TOKEN=  # 可选；与 PROXY_AUTH_TOKEN 二选一或相同
#
# R2（S5 视频落库，必填）
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# 若省略 ENDPOINT，可改填 R2_ACCOUNT_ID（将拼出默认 Endpoint）
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
# 兼容旧变量名：R2_ACCESS_KEY / R2_SECRET_KEY
