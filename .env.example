PROXY_AUTH_TOKEN=replace-with-your-internal-token
OPENAI_API_KEY=replace-with-your-api-key
# xAI 示例：https://api.x.ai/v1 ；官方 OpenAI：https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 文本 chat/completions（/text/completions 等）：不设可能在下游报「未配置模型」
XAI_TEXT_MODEL=
XAI_MODEL=grok-4.20

# 图片 /images/generations 专用（绝不回退到上面的 XAI_MODEL，避免把 grok-4.20 发到图片接口）
# 优先级：请求 body.model → XAI_IMAGE_MODEL → SHORT_DRAMA_XAI_IMAGE_MODEL → IMAGE_MODEL → grok-imagine-image
XAI_IMAGE_MODEL=grok-imagine-image

# S1 视觉 /s1/vision（可选；不设则按顺序尝试 XAI_MODEL、OPENAI_MODEL）
# S1_VISION_MODEL=

# OPENAI_MODEL=gpt-4o
REQUEST_TIMEOUT_SECONDS=120
